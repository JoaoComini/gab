func run(): i32 {
    assert(1 + 2 == 3);
    assert(7 - 9 == -2);
    assert(6 * 7 == 42);
    assert(9 / 2 == 4);
    assert(7 % 3 == 1);

    assert(1.5 + 2.5 == 4.0);
    assert(3.0 * 2.0 == 6.0);

    assert(-(3) == -3);
    assert(!false);

    assert(i32(2.9) == 2);
    assert(f32(3) == 3.0);

    return 0;
}
