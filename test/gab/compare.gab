func run(): i32 {
    assert(1 < 2);
    assert(!(2 < 1));
    assert(2 > 1);
    assert(1 <= 1);
    assert(2 >= 2);
    assert(1 == 1);
    assert(1 != 2);

    assert(1.5 < 2.5);
    assert(2.5 > 1.5);
    assert(1.5 <= 1.5);
    assert(2.5 >= 2.5);
    assert(1.5 == 1.5);
    assert(1.5 != 2.5);

    assert(true == true);
    assert(true != false);

    return 0;
}
