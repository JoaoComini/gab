struct Point { x: i32, y: i32 }

struct Mixed { n: i32, f: f32, flag: bool }

struct Nested { inner: Point, tag: i32 }

func sum(p: Point): i32 { return p.x + p.y; }

func peek(p: &Point): i32 { return p.x; }

func bump(p: &Point) { p.x = p.x + 1; }

func made(x: i32): Point { return Point { x: x, y: x * 2 }; }

func run(): i32 {
    let p = Point { x: 40, y: 2 };
    assert(p.x == 40);
    assert(p.y == 2);
    assert(sum(p) == 42);
    assert(peek(p) == 40);

    let q = Point { y: 2, x: 40 };
    assert(q.x == 40);

    let m = Mixed { n: 1, f: 2.5, flag: true };
    assert(m.n == 1);
    assert(m.f == 2.5);
    assert(m.flag);

    let outer = Nested { inner: Point { x: 3, y: 4 }, tag: 7 };
    assert(outer.inner.x == 3);
    assert(outer.inner.y == 4);
    assert(outer.tag == 7);

    let mut = Point { x: 1, y: 1 };
    mut.x = 5;
    assert(mut.x == 5);

    bump(mut);
    assert(mut.x == 6);

    let copied = p;
    assert(copied.x == 40);

    let built = made(5);
    assert(built.x == 5);
    assert(built.y == 10);

    return 0;
}
