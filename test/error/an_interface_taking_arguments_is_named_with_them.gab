interface Holder<T> {
    func get(self: &Self): T;
}

interface Countable {
    func count(self: &Self): i32;
}

struct IntBox { n: i32 }

struct Bag { n: i32 }

impl IntBox as Holder {
    func get(self: &IntBox): i32 { return self.n; }
}

impl Bag as Countable<i32> {
    func count(self: &Bag): i32 { return self.n; }
}

