struct Node { n: i32 }

struct View { r: &Node }

struct Outer { v: View }

func directly(): View {
    let owned = Node { n: 1 };
    return View { r: owned };
}

func nested(): Outer {
    let owned = Node { n: 1 };
    return Outer { v: View { r: owned } };
}

