struct Inner { n: i32 }

struct Outer { child: Unique<Inner> }

func f(): i32 {
    let o: Unique<Outer> = Unique<Outer>::new(Outer { child: Unique<Inner>::new(Inner { n: 0 }) });
    let i: Unique<Inner> = Unique<Inner>::new(Inner { n: 0 });
    (*o).child = i;
    return (*i).n;
}

