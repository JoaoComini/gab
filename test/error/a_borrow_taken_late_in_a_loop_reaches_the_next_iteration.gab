struct Box { n: i32 }

func f(): i32 {
    let heap: *Box = box Box { n: 0 };
    let out: &Box = heap;
    {
        let inner = Box { n: 0 };
        let a: &Box = heap;
        for let i = 0; i < 2; i = i + 1 {
            out = a;
            a = inner;
        }
    }
    return out.n;
}

