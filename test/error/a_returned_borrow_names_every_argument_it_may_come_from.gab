struct Box { n: i32 }

func choose(a: &Box, b: &Box, flag: bool): &Box {
    if flag { return a; }
    return b;
}

func f(): i32 {
    let owner: *Box = box Box { n: 0 };
    let got: &Box = owner;
    { let inner = Box { n: 1 }; got = choose(owner, inner, true); }
    return got.n;
}

