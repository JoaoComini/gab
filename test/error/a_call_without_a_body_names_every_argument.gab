struct Box { n: i32 }

extern func pick(a: &Box, b: &Box): &Box;

func f(): i32 {
    let owner: *Box = box Box { n: 0 };
    let got: &Box = owner;
    { let inner = Box { n: 1 }; got = pick(owner, inner); }
    return got.n;
}

