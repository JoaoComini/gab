func an_int(): bool {
    let x: i32 = 1;
    return !x;
}

func a_float(): bool {
    let x: f32 = 1.0;
    return !x;
}

func a_borrow(): bool {
    let x: i32 = 1;
    let p: &i32 = x;
    return !p;
}

