module test;
import testing;

struct Player { health: i32, mana: i32 }

struct Inner { n: i32 }

struct Outer { child: Unique<Inner> }

impl Player {
    func hurt(self: &Player, n: i32): i32 { self.health = self.health - n; return self.health; }
}

func returned(): Unique<Inner> { return Unique<Inner>::new(Inner { n: 7 }); }

func made(): Unique<Inner> { return Unique<Inner>::new(Inner { n: 6 }); }

func borrows(b: &Inner): i32 { return b.n; }

func in_a_block(): i32 {
    let t: i32 = 0;
    { let a: Unique<Inner> = Unique<Inner>::new(Inner { n: 3 }); t = (*a).n; }
    return t;
}

func unread(): i32 {
    Unique<Inner>::new(Inner { n: 0 });
    return 4;
}

func unread_struct(): i32 {
    Outer { child: Unique<Inner>::new(Inner { n: 0 }) };
    return 4;
}

func run(): i32 {
    let n: Unique<i32> = Unique<i32>::new(7);
    assert(*n == 7);

    let flag: Unique<bool> = Unique<bool>::new(true);
    assert(*flag);

    let p: Unique<Player> = Unique<Player>::new(Player { health: 3, mana: 4 });
    assert((*p).health + (*p).mana == 7);

    (*p).health = 50;
    assert((*p).hurt(8) == 42);

    let a: Unique<Inner> = Unique<Inner>::new(Inner { n: 1 });
    let b: Unique<Inner> = Unique<Inner>::new(Inner { n: 2 });
    assert((*a).n * 10 + (*b).n == 12);

    let held = returned();
    assert((*held).n == 7);

    let o: Unique<Outer> = Unique<Outer>::new(Outer { child: Unique<Inner>::new(Inner { n: 1 }) });
    (*o).child = Unique<Inner>::new(Inner { n: 9 });
    assert((*(*o).child).n == 9);

    (*o).child = made();
    assert((*(*o).child).n == 6);

    let aliased: &Inner = *a;
    assert(aliased.n == 1);

    assert(borrows(*a) == 1);
    assert((*a).n == 1);

    assert(in_a_block() == 3);
    assert(unread() == 4);
    assert(unread_struct() == 4);

    return 0;
}
