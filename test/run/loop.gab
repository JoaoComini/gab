module test;
import check;

func counted(n: i32): i32 {
    let acc: i32 = 0;
    for let i: i32 = 0; i < n; i = i + 1 { acc = acc + i; }
    return acc;
}

func stepped(n: i32): i32 {
    let acc: i32 = 0;
    for let i: i32 = 0; i < n; i += 1 { acc = acc + i; }
    return acc;
}

func skipping(n: i32): i32 {
    let total: i32 = 0;
    for let i: i32 = 0; i < n; i = i + 1 {
        if i < 3 { continue; }
        total = total + i;
    }
    return total;
}

func until_broken(): i32 {
    let i: i32 = 0;
    for { i = i + 1; if i > 2 { break; } }
    return i;
}

func while_shaped(): i32 {
    let i: i32 = 0;
    for i < 3 { i = i + 1; }
    return i;
}

func self_stepped(n: i32): i32 {
    let acc: i32 = 0;
    for let i: i32 = 0; i < n; i = i + 1 { acc = acc + 1; i = i + 1; }
    return acc;
}

func summed(n: i32): i32 {
    let total: i32 = 0;
    for let i: i32 = 0; i < n; i = i + 1 { total = total + i; }
    return total;
}

func run(): i32 {
    assert(self_stepped(6) == 3);
    assert(summed(4) == 6);

    assert(counted(5) == 10);
    assert(stepped(5) == 10);
    assert(skipping(5) == 7);
    assert(until_broken() == 3);
    assert(while_shaped() == 3);

    let skipped: i32 = 0;
    for false { skipped = 1; }
    assert(skipped == 0);

    return 0;
}
