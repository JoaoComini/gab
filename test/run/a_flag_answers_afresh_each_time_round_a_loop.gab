module test;
import testing;

struct Node { seen: Unique<i32> }

func take(p: Unique<Node>): i32 { return 1; }

func rounds(): i32 {
    let total: i32 = 0;

    for let i: i32 = 0; i < 3; i = i + 1 {
        let a: Unique<Node> = Unique<Node>::new(Node { seen: Unique<i32>::new(0) });

        if i == 1 { total = total + take(a); }
    }

    return total;
}

func run(): i32 {
    assert(rounds() == 1);

    return 0;
}
