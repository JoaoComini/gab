module test;
import testing;

struct Node { seen: *i32 }

func take(p: *Node): i32 { return 1; }

func rounds(): i32 {
    let total: i32 = 0;

    for let i: i32 = 0; i < 3; i = i + 1 {
        let a: *Node = box Node { seen: box 0 };

        if i == 1 { total = total + take(a); }
    }

    return total;
}

func run(): i32 {
    assert(rounds() == 1);

    return 0;
}
