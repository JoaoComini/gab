module test;
import testing;

struct Box { n: i32 }

struct Inner { n: i32 }

struct Owner { i: Unique<Inner> }

impl Box {
    func take(self: &Box): i32 { return self.n; }

    func adopt(self: &Box, other: Unique<Box>): i32 { return (*other).n; }
}

func consume(b: Unique<Box>): i32 { return (*b).n; }

func peek(b: &Box): i32 { return b.n; }

func through(b: Unique<Box>): Unique<Box> { return b; }

func take_owner(o: Owner): i32 { return (*o.i).n; }

func run(): i32 {
    let moved: Unique<Box> = Unique<Box>::new(Box { n: 6 });
    assert(consume(moved) == 6);

    let borrowed: Unique<Box> = Unique<Box>::new(Box { n: 4 });
    assert(peek(*borrowed) + (*borrowed).n == 8);

    let value = Box { n: 6 };
    assert(peek(value) == 6);

    let returned: Unique<Box> = Unique<Box>::new(Box { n: 9 });
    let back: Unique<Box> = through(returned);
    assert((*back).n == 9);

    let named: Unique<Box> = Unique<Box>::new(Box { n: 4 });
    assert(Box::take(*named) == 4);

    let host: Unique<Box> = Unique<Box>::new(Box { n: 0 });
    let gift: Unique<Box> = Unique<Box>::new(Box { n: 3 });
    assert((*host).adopt(gift) == 3);

    let owner = Owner { i: Unique<Inner>::new(Inner { n: 1 }) };
    assert(take_owner(owner) == 1);

    return 0;
}
