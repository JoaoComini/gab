module test;
import testing;

struct Node { n: i32 }

struct Pair { a: i32, b: i32 }

func escaping(): Unique<Node> { return Unique<Node>::new(Node { n: 7 }); }

func through_a_ref(p: &Node): i32 { return p.n; }

func run(): i32 {
    let p: Unique<Node> = Unique<Node>::new(Node { n: 3 });
    assert((*p).n == 3);

    (*p).n = 42;
    assert((*p).n == 42);

    let escaped = escaping();
    assert((*escaped).n == 7);

    let one: Unique<Node> = Unique<Node>::new(Node { n: 1 });
    let two: Unique<Node> = Unique<Node>::new(Node { n: 2 });
    assert((*one).n == 1);
    assert((*two).n == 2);

    assert(through_a_ref(*one) == 1);

    let wide: Unique<Pair> = Unique<Pair>::new(Pair { a: 8, b: 9 });
    assert((*wide).a == 8);
    assert((*wide).b == 9);

    return 0;
}
