module test;
import testing;

func added(a: i32, b: i32): i32 { return a + b; }

func divided(a: i32, b: i32): i32 { return a / b; }

func run(): i32 {
    assert(added(2, 3) == 5);
    assert(added(-2, 3) == 1);
    assert(added(2147483647, 0) == 2147483647);

    assert(divided(7, 2) == 3);
    assert(divided(-7, 2) == -3);
    assert(divided(-2147483647, -1) == 2147483647);
    assert(divided(-10, -1) == 10);

    assert(1 + 2 * 3 == 7);
    assert((1 + 2) * 3 == 9);
    assert(10 - 3 - 2 == 5);
    assert(100 / 10 / 2 == 5);
    assert(2 + 3 * 4 - 6 / 2 == 11);

    let ten: i32 = 10;
    assert(ten + 3 == 13);
    assert(ten - 3 == 7);
    assert(ten * 3 == 30);
    assert(ten / 3 == 3);

    assert(2 + 3 * 4 == 14);
    assert((7 - 2) * 3 == 15);
    assert(7 / 2 == 3);
    assert(-7 / 2 == -3);
    assert(-7 % 2 == -1);
    assert(2147483647 + 1 == -2147483647 - 1);
    assert(1.5 * 2.0 == 3.0);

    let one: f32 = 1.0;
    let zero: f32 = 0.0;
    assert(one / zero > 0.0);

    assert(1 + 2 == 3);
    assert(7 - 9 == -2);
    assert(6 * 7 == 42);
    assert(9 / 2 == 4);
    assert(7 % 3 == 1);

    assert(1.5 + 2.5 == 4.0);
    assert(3.0 * 2.0 == 6.0);

    assert(-(3) == -3);
    assert(!false);

    assert(i32(2.9) == 2);
    assert(f32(3) == 3.0);

    return 0;
}
