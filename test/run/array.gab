module test;
import check;

struct Cell { n: i32 }

func written_out(): i32 {
    let xs: array<i32, 3> = [1, 20, 300];

    return xs[0] + xs[1] + xs[2];
}

func elements_are_distinct(): i32 {
    let xs: array<i32, 2> = [1, 2];

    xs[0] = 9;

    return xs[0] * 10 + xs[1];
}

func a_struct_element_keeps_its_own_slot(): i32 {
    let xs: array<Cell, 2>;

    xs[0].n = 3;
    xs[1].n = 4;

    return xs[0].n * 10 + xs[1].n;
}

func knows_its_length(): i32 {
    let xs: array<i32, 4> = [1, 2, 3, 4];

    return xs.len();
}

func borrowed_knows_its_length(xs: &array<i32, 4>): i32 { return xs.len(); }

func copies(): i32 {
    let xs: array<i32, 2> = [1, 2];
    let ys = xs;

    ys[0] = 9;

    return xs[0] * 10 + ys[0];
}

func run(): i32 {
    assert(written_out() == 321);
    assert(elements_are_distinct() == 92);
    assert(a_struct_element_keeps_its_own_slot() == 34);
    assert(knows_its_length() == 4);

    let xs: array<i32, 4> = [1, 2, 3, 4];

    assert(borrowed_knows_its_length(xs) == 4);
    assert(copies() == 19);

    return 0;
}
