func run(): i32 {
    let a: i32 = 4;
    a += 3;
    assert(a == 7);

    a -= 3;
    assert(a == 4);

    a *= 3;
    assert(a == 12);

    a /= 4;
    assert(a == 3);

    a = 17;
    a %= 5;
    assert(a == 2);

    a = 1;
    a += 2 * 3;
    assert(a == 7);

    let b: i32 = 4;
    a = 1;
    a += b - 1;
    assert(a == 4);

    let f: f32 = 1.5;
    f += 2.0;
    assert(f == 3.5);

    f *= 2.0;
    assert(f == 7.0);

    return 0;
}
