module core;

extern "C" func write(fd: i32, message: &u8, length: i32): i32;
extern "C" func abort();

/* Where a check the compiler emitted has failed, such as an index out of range. Written to fd 2 rather
 * than printed, since 'abort' flushes nothing and a buffered message is never seen. */
func trap(message: &u8, length: i32) {
    write(2, message, length);
    abort();
}

/* Where a call was written, which '@caller()' in a 'caller' function answers with. */
struct Location {
    line: i32,
    column: i32,
}

/* What a type does as it ends, run before what it owns is released. */
interface Destroy {
    func destroy(self: &Self);
}

/* 'str' reads as a slice of bytes, so what a slice declares precedes it. */
interface Index<T> {
    func index(self: &Self, at: i32): &T;
}

impl<T> slice<T> {
    intrinsic func len(self: &slice<T>): i32;
}

impl<T> slice<T> as Index<T> {
    intrinsic func index(self: &slice<T>, at: i32): &T;
}

/* A raw run has no length, so nothing bounds its index and nothing it holds is dropped through it. */
impl<T> raw<T> as Index<T> {
    intrinsic func index(self: &Self, at: i32): &T;
}

impl<T, N: i32> array<T, N> {
    intrinsic func len(self: &Self): i32;
}

impl<T, N: i32> array<T, N> as Index<T> {
    intrinsic func index(self: &Self, at: i32): &T;
}

impl str {
    intrinsic func as_bytes(self: &str): &slice<u8>;

    func len(self: &str): i32 { return self.as_bytes().len(); }
}
